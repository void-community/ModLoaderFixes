<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <JvmBridgeAgent>true</JvmBridgeAgent>
    <PublishAot>true</PublishAot>
    <!-- Compiling the Java helpers needs a JDK; this downloads a pinned one when JvmBridgeJdkHome and JAVA_HOME name none. -->
    <JvmBridgeProvisionJdk>true</JvmBridgeProvisionJdk>
    <!-- Publishing also writes ModLoaderFixes.jar beside the library, a jar for java -javaagent that holds the library of the published platform. -->
    <JvmBridgeAgentJar>true</JvmBridgeAgentJar>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <Description>A native JVM agent that fixes Forge, NeoForge and Minecraft servers and clients where their own code breaks.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JvmBridge" />
    <JavaSource Include="java/**/*.java" />
    <!-- Stand-ins for the game's classes that the helpers compile against; the JVM links the helpers to the real ones, so these are never shipped. -->
    <JavaStubSource Include="stubs/**/*.java" />
    <InternalsVisibleTo Include="ModLoaderFixes.Tests" />
    <!-- The generator runs on the build machine, so it is built for it whatever platform the agent targets, and the agent doesn't reference its assembly. -->
    <ProjectReference Include="../ModLoaderFixes.Mappings/ModLoaderFixes.Mappings.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <!--
    The classes and methods that the patches name by the names Forge runs them under: MCP's up to Minecraft 1.16.5, Mojang's from 1.17, so a range of releases
    can't cross 1.17. Vanilla obfuscates them under other names in every release, so as the agent builds, src/ModLoaderFixes.Mappings finds each one in every
    release from From to To, through Forge's, Ornithe's and Mojang's mappings, and compiles their names into MappedClasses, whose property each item names.
    Methods lists each method by its name followed by its descriptor, separated by spaces.
  -->
  <ItemGroup>
    <MappedClass Include="NetworkManager" Class="net/minecraft/network/NetworkManager" From="1.7.2" To="1.14.3" Methods="func_150733_h()V" />
    <MappedClass Include="NetworkInitializer" Class="net/minecraft/network/NetworkSystem$1" From="1.7.2" To="1.7.10" />
    <MappedClass Include="MemoryInitializer" Class="net/minecraft/network/NetworkSystem$2" From="1.7.2" To="1.7.10" />
    <MappedClass Include="PlayerController" Class="net/minecraft/client/multiplayer/PlayerControllerMP" From="1.7.2" To="1.7.10" Methods="func_78765_e()V" />
    <MappedClass Include="SoundManager" Class="net/minecraft/client/audio/SoundManager" From="1.7.2" To="1.13.2" Methods="func_148608_i()V func_148596_a()V func_148613_b()V" />
    <MappedClass Include="ChannelManager" Class="net/minecraft/client/audio/ChannelManager" From="1.14" To="1.16.5" />
    <MappedClass Include="ChannelAccess" Class="net/minecraft/client/sounds/ChannelAccess" From="1.17" To="1.20.4" />
    <MappedClass Include="AsyncReloader" Class="net/minecraft/resources/AsyncReloader" From="1.16" To="1.16.5" />
    <MappedClass Include="SimpleReloadInstance" Class="net/minecraft/server/packs/resources/SimpleReloadInstance" From="1.17" To="1.18.2" />
    <MappedClass
      Include="PlayClientHandler"
      Class="net/minecraft/client/network/NetHandlerPlayClient"
      From="1.13"
      To="1.13.2"
      Methods="func_147253_a(Lnet/minecraft/network/play/server/SPacketDisconnect;)V"
    />
    <MappedClass
      Include="PlayNetHandler"
      Class="net/minecraft/client/network/play/ClientPlayNetHandler"
      From="1.14"
      To="1.16.5"
      Methods="func_147253_a(Lnet/minecraft/network/play/server/SDisconnectPacket;)V"
    />
    <MappedClass
      Include="PacketListener"
      Class="net/minecraft/client/multiplayer/ClientPacketListener"
      From="1.17"
      To="1.20.1"
      Methods="handleDisconnect(Lnet/minecraft/network/protocol/game/ClientboundDisconnectPacket;)V"
    />
    <MappedClass
      Include="CommonPacketListener"
      Class="net/minecraft/client/multiplayer/ClientCommonPacketListenerImpl"
      From="1.20.2"
      To="1.21.11"
      Methods="handleDisconnect(Lnet/minecraft/network/protocol/common/ClientboundDisconnectPacket;)V"
    />
  </ItemGroup>
  <!--
    The build resolves the names into Mappings.g.cs under obj again whenever the items or the generator change, and keeps the downloaded mappings in
    artifacts/mappings.
  -->
  <Target Name="ResolveMappingsGenerator" DependsOnTargets="ResolveProjectReferences">
    <!-- obj's path is only known once the SDK's targets have set it, so the table's is set here rather than with the project's properties. -->
    <PropertyGroup>
      <MappingsCache>$(MSBuildThisFileDirectory)../../artifacts/mappings</MappingsCache>
      <MappingsRequests>$(IntermediateOutputPath)MappedClasses.txt</MappingsRequests>
      <MappingsTable>$(IntermediateOutputPath)Mappings.g.cs</MappingsTable>
    </PropertyGroup>
    <!-- One line per item, its fields separated by tabs; the file keeps its time while the items stay the same, so it tells when they change. -->
    <WriteLinesToFile File="$(MappingsRequests)" Lines="@(MappedClass->'%(Identity)%09%(Class)%09%(From)%09%(To)%09%(Methods)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <MSBuild Projects="../ModLoaderFixes.Mappings/ModLoaderFixes.Mappings.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="MappingsGenerator" />
    </MSBuild>
  </Target>
  <Target Name="GenerateMappings" BeforeTargets="CoreCompile" DependsOnTargets="ResolveMappingsGenerator" Inputs="$(MappingsRequests);@(MappingsGenerator)" Outputs="$(MappingsTable)">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;@(MappingsGenerator)&quot; &quot;$(MappingsRequests)&quot; &quot;$(MappingsTable)&quot; &quot;$(MappingsCache)&quot;" />
  </Target>
  <Target Name="CompileMappings" BeforeTargets="CoreCompile" DependsOnTargets="GenerateMappings">
    <ItemGroup>
      <Compile Include="$(MappingsTable)" />
      <FileWrites Include="$(MappingsRequests);$(MappingsTable)" />
    </ItemGroup>
  </Target>
</Project>
