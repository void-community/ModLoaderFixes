<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Keep dotnet test on the configured VSTest adapter and retain standalone xUnit execution. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JvmBridge.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <None Include="Fixtures/**/*.java" CopyToOutputDirectory="PreserveNewest" />
    <!-- The data pack that a server test generates a world with. -->
    <None Include="Fixtures/**/*.json;Fixtures/**/*.mcmeta" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    CI hands the tests what it published, in artifacts/publish-<runtime>, and what it releases, in artifacts/bundle. The tests look for the agent of their
    platform in artifacts/agent, so its library goes there beside the release's jar, which holds the library of every platform. The servers that tests start
    in containers are 64-bit Linux with glibc whatever platform the tests run on, so the libraries of linux-x64 and linux-arm64 go there too.
  -->
  <Target Name="CopyPublishedAgent" AfterTargets="Build">
    <ItemGroup>
      <AgentRuntime Include="linux-x64;linux-arm64" />
      <AgentRuntime Include="$(NETCoreSdkRuntimeIdentifier)" Exclude="@(AgentRuntime)" />
      <PublishedAgentFile
        Include="../../artifacts/publish-%(AgentRuntime.Identity)/ModLoaderFixes/*"
        Exclude="../../artifacts/publish-%(AgentRuntime.Identity)/ModLoaderFixes/*.jar"
        Runtime="%(AgentRuntime.Identity)"
      />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedAgentFile)" DestinationFiles="@(PublishedAgentFile->'../../artifacts/agent/%(Runtime)/%(Filename)%(Extension)')" />
    <Copy
      SourceFiles="../../artifacts/bundle/modloaderfixes.jar"
      DestinationFiles="../../artifacts/agent/%(AgentRuntime.Identity)/ModLoaderFixes.jar"
      Condition="Exists('../../artifacts/publish-%(AgentRuntime.Identity)/ModLoaderFixes')"
    />
  </Target>
</Project>
